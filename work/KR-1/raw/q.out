  <script type="text/javascript">
    //링크 체크
    var webRoot = '/LSW';
    var isAsGubun = "IS";
    var layerDiv = ".layerPop > .inner .cont .bodySideContent";

    function isOutUrl(url){
        if(!url) return false;
        url = url.trim();
        if(url.indexOf('/LSW') === 0) return false;
        if(url.indexOf('blob')>-1) return false;
        if(url.charAt(0) === '/') return false;
        if(/^https?:\/\//i.test(url)) return false;
        if(url.indexOf('www.') === 0) return false;
        if(/^(javascript|#)/i.test(url)) return false;
        return true;
    }

    function resolveUrl(url){
        return isOutUrl(url) ? webRoot + '/' + url : url;
    }

    function checkP(url){
        if(!url) return false;
        return /Info|Proc/i.test(url);
    }
    
    (function (){
        let originalOpen = window.open;

        //window.open
        window.open = function(url,name,specs){
            let resolved = resolveUrl(url);

            if(checkP(resolved) && !specs){
                specs ='width=1000px,height=800px';
            }else if(checkP(resolved)){
            }
            if(url.includes('listShowYn=Y')){
                resolved = resolved.replace('listShowYn=Y','listShowYn=N')
            }
            return originalOpen.call(window,resolved , name, specs);
        };

        let originalSubmit = HTMLFormElement.prototype.submit;

        HTMLFormElement.prototype.submit = function(){

            let action = this.getAttribute('action');
            if(action && isOutUrl(action)){
                this.setAttribute('action',resolveUrl(action))
            }
            return originalSubmit.call(this);
        }

        let originalXhrOpen = XMLHttpRequest.prototype.open;
        XMLHttpRequest.prototype.open = function(method,url){
            arguments[1] = resolveUrl(url);
            return originalXhrOpen.apply(this,arguments);
        }

    })();

    //ajax
    $.ajaxPrefilter(function (options){
        options.url = resolveUrl(options.url);
    });

    //a태그 herf
    $(document).on('click','a[href]',function(e){
        let href = $(this).attr('href');

/*
        //view가 infoP호출이면 가로챔
        if(checkP(href)){
            e.preventDefault();
            window.open(setListShowYn(resolveUrl(href)),'_blank','width=1000px,height=800px');
        }
*/

        if(isOutUrl(href)){
            e.preventDefault();
            let newHref = resolveUrl(href);
            let target = $(this).attr('target');

            if(target === '_blank'){
                window.open(newHref,'_blank','width=1000px,height=800px');
            }else{
                window.location.href = newHref;
            }
        }
    })

    $(document).on('submit','form',function(e){
       let $form = $(this);
       let action  = $form.attr('action');

       if(checkP(action) && $form.attr('target') ==='_blank'){
           e.preventDefault();
           let popupName = 'popup_'+Date.now();
           window.open('',popupName,'width=1000px,height=800px');
           $form.attr('action',resolveUrl(action));
           $form.attr('target',popupName);

           let $listShowYn = $('<input>', {type : 'hidden', name:'listShowYn',value:'N'});
           $form.append($listShowYn);
           $form[0].submit();
           $listShowYn.remove();
           return;
       }

       if(isOutUrl(action)){
           $form.attr('action',resolveUrl(action));
       }
    })

</script>
