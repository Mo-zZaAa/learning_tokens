  <script type="text/javascript">
    $(document).ready(function (){
      if(false){
        searchList('','');
      }
      callLsBylInfoR();
    });

    function callLsBylInfoR(){
      setDetailSelectBylCookie('ls',$("#bylSeq").val());
      $.ajax({
        url: "lsBylInfoR.do",
        type:'POST',
        data: {
          'bylSeq': $("#bylSeq").val(),
          'lsiSeq': $("#lsiSeq").val(),
          'vSct': $("#vSct").val(),
          'efYd': $("#efYd").val()
        },
        timeout : 150000,
        error : function(request,status,error){
          alert("다시 시도해주세요.");
        },
        success: function(responseData){
          $("#lsBylInfoDiv").html(responseData);
          fHstLsBylList();
          // $("#bylContents").css("height", $(window).innerHeight()-250);
        }
      });
    }

    //목록검색
    function searchList(pg,query2,cb){
      $("#frm_pg").val(pg);
      $("#frm_query2").val(query2);
        layoutLoadMask();
      hNavigating = false;
        $.ajax({
          url:'lsBylSc.do',
          type:'POST',
          data: $.param($("#infoFrm").serializeArray().filter(function(ele){ return ele.value !== ''})) ,
          success : function(responseData) {
            $("#lsBylSearchResult").html(responseData);
            //일치하는 검색결과가 없을때
            setTimeout(function (){
              if(!hNavigating && cb) cb();
            },0)
            requestAnimationFrame(function(){
              requestAnimationFrame(function(){
                layoutUnMask();
              })
            })
          }
        })
    }


    function openGovLink(){
      let govLnk = $("#govLnk").attr("href");
      if(govLnk){
        window.open(govLnk, "_blank", 'noopener');
      }
    }

    // 별표 저장
  </script> 
